#!/bin/sh
# Conventional Commits 검사: <type>(<scope>)?: <subject>
# 우회: git commit --no-verify
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# merge / revert / fixup / squash 커밋은 통과
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|refactor|perf|test|docs|chore|style|build|ci)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "❌ 커밋 메시지가 Conventional Commits 형식이 아닙니다."
  echo ""
  echo "   형식: <type>(<scope>): <subject>"
  echo "   type: feat fix refactor perf test docs chore style build ci"
  echo "   예시: feat(quiz): add streak counter to result screen"
  echo ""
  echo "   현재: $first_line"
  exit 1
fi

if [ ${#first_line} -gt 72 ]; then
  echo "⚠️  첫 줄이 72자를 넘습니다 (${#first_line}자). 짧게 줄이세요."
  exit 1
fi

exit 0
